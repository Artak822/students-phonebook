# Backend
DATABASE_URL=postgresql+asyncpg://aspirs:aspirs@db:5432/aspirs
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-256-bit-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_LOGIN=10/5minutes
LOG_LEVEL=INFO

# CORS и cookies
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# S3 (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aspirs

# Бэкапы
BACKUP_S3_BUCKET=aspirs-backups
BACKUP_CRON=0 3 * * *
BACKUP_LOCAL_KEEP=7
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_DAYS=90
BACKUP_RETENTION_MONTHLY_DAYS=365

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
