# База данных (пароль ОБЯЗАТЕЛЬНО сменить)
DATABASE_URL=postgresql+asyncpg://aspirs:REPLACE_ME@db:5432/aspirs
POSTGRES_PASSWORD=REPLACE_ME

REDIS_URL=redis://redis:6379/0

# Ключ подписи JWT — минимум 32 символа, криптостойкий
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOG_LEVEL=INFO

CORS_ORIGINS=[]
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# MinIO (консоль недоступна снаружи — порт 9001 закрыт)
S3_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=aspirs

BACKEND_URL=http://backend:8000
